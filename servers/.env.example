# 阿瓦隆后端配置：逻辑后端、API 后端都读这一个文件。复制为 .env 后填写；.env 不进 git。
# 端口、目录等都已固定在程序里，这里只放需要你决定的内容。

# API 后端监听的地址：模拟器用"IP:端口"直连它。
# 只在本机用写 127.0.0.1；要让别人的模拟器连进来写 0.0.0.0
AVALON_API_HOST=127.0.0.1
AVALON_API_PORT=7900

# 网站通过 HTTPS 对外提供时设为 true；本机 HTTP 开发保持 false
AVALON_WEB_COOKIE_SECURE=false

# 令牌：留空即可，uv run app.py 第一次运行时自动生成
# 同时按 bot/nonebot/.env 的 ENVIRONMENT 创建机器人配置，并填充空白 API 令牌
AVALON_INTERNAL_TOKEN=
AVALON_BOT_TOKEN=
AVALON_SIM_TOKEN=
