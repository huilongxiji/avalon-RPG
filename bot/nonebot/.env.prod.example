# 正式环境配置示例。复制为 .env.prod 后填写，并把 .env 里的 ENVIRONMENT 改成 prod；.env.prod 不进 git。
# 监听地址：goqbot 反向连接 ws://127.0.0.1:7891/onebot/v11/ws
HOST=127.0.0.1
PORT=7891
COMMAND_START=["/", ".", "。"]
# 管理员 QQ 号，如 ["123456789"]
SUPERUSERS=[]
# 必须与 goqbot 的 config.yml 里的 access_token 一致
ONEBOT_ACCESS_TOKEN=
# markdown（原生消息 + 按钮）或 text
GAME_SEND_MODE=markdown

# 调用 API 后端
AVALON_API_URL=http://127.0.0.1:7900
# 与 API 后端认的 bot 令牌一致（一键脚本会在这里为空时自动填上）
AVALON_API_TOKEN=
